<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.jinahya</groupId>
    <artifactId>reactive-streams-jvm-tck-junit-jupiter</artifactId>
    <version>0.0.4</version>
  </parent>

  <artifactId>reactive-streams-tck-flow-junit-jupiter</artifactId>
  <packaging>jar</packaging>

  <name>${project.artifactId}</name>
  <description>JUnit Jupiter port of the Reactive Streams TCK for java.util.concurrent.Flow</description>

  <dependencies>
    <!-- Sibling: the Jupiter TCK base classes for Reactive Streams Publisher/Subscriber/Processor -->
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>reactive-streams-tck-junit-jupiter</artifactId>
    </dependency>

    <!--
      The spec API + FlowAdapters (in the Java 9 source set). Scope is provided
      because the sibling module declares reactive-streams at provided scope too
      (provided does not propagate transitively), and consumers of this artifact
      are by definition implementing a Flow type, so they already have it.
    -->
    <dependency>
      <groupId>org.reactivestreams</groupId>
      <artifactId>reactive-streams</artifactId>
      <scope>provided</scope>
    </dependency>

    <!--
      Jupiter API at provided scope, same rationale as the sibling module:
      our Flow variants subclass classes that carry Jupiter annotations, so the
      compiler needs the API visible. We don't propagate it transitively.
    -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
      <scope>provided</scope>
    </dependency>

    <!-- Test scope -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-engine</artifactId>
      <scope>test</scope>
    </dependency>
    <!--
      Test-scope only: upstream's example Publisher/Subscriber impls wrapped through
      FlowAdapters to drive the Flow variants of our TCK. NOT propagated to consumers.
    -->
    <dependency>
      <groupId>org.reactivestreams</groupId>
      <artifactId>reactive-streams-examples</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
