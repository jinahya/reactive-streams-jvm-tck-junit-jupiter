<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.jinahya</groupId>
    <artifactId>reactive-streams-jvm-tck-junit-jupiter</artifactId>
    <version>0.0.3-SNAPSHOT</version>
  </parent>

  <artifactId>tck-junit-jupiter</artifactId>
  <packaging>jar</packaging>

  <name>${project.artifactId}</name>
  <description>JUnit Jupiter port of the Reactive Streams TCK (verifies Publisher/Subscriber/Processor implementations against the spec)</description>

  <dependencies>
    <!--
      The spec API: Publisher / Subscriber / Subscription / Processor.
      Scope is provided: consumers of this TCK are by definition implementing or testing
      one of these types, so they already have reactive-streams on their classpath.
      Symmetric to junit-jupiter-api below: we don't dictate the version transitively.
    -->
    <dependency>
      <groupId>org.reactivestreams</groupId>
      <artifactId>reactive-streams</artifactId>
      <scope>provided</scope>
    </dependency>
    <!--
      The TestNG-free portion of the upstream TCK (rules interfaces, helper publishers,
      support utilities) and AsyncIterablePublisher are inlined into this jar under
      their original packages. No transitive dependency on reactive-streams-tck or
      reactive-streams-examples is needed.
    -->
    <!--
      Jupiter API: @Test, Assertions, Assumptions, @TestInstance, etc.
      Scope is provided: consumers of this artifact already have JUnit Jupiter on their
      test classpath, and we don't want to dictate their Jupiter version transitively
      (the inherited dependencyConvergence enforcer in jinahya-parent would penalize
      version mismatches). Pulls in opentest4j (TestAbortedException) transitively
      under the same scope.
    -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
      <scope>provided</scope>
    </dependency>

    <!-- Test scope: run the Jupiter engine against our own example verification subclasses -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-engine</artifactId>
      <scope>test</scope>
    </dependency>
    <!--
      Test-scope only: upstream's example Publisher/Subscriber impls (RangePublisher,
      SyncSubscriber, AsyncSubscriber) used as known-good subjects to self-test this
      module's verification classes. NOT propagated to consumers.
    -->
    <dependency>
      <groupId>org.reactivestreams</groupId>
      <artifactId>reactive-streams-examples</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
